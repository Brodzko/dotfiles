{
  "editor.fontFamily": "Fira Code",
  "editor.fontLigatures": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.detectIndentation": true,
  "typescript.validate.enable": true,
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.renderWhitespace": "boundary",
  "editor.linkedEditing": true,
  "files.exclude": {
    "USE_GITIGNORE": true,
  },
  "files.associations": {
    "*.md": "markdown",
    "*.mdx": "markdown",
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  "prettier.bracketSpacing": true,
  "prettier.proseWrap": "always",
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "all",
  "prettier.useEditorConfig": false,
  "gitlens.views.repositories.files.layout": "list",
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
    "other": "on",
  },
  "emmet.excludeLanguages": ["markdown"],
  "emmet.includeLanguages": {
    "typescript": "typescriptreact",
    "javascript": "javascriptreact",
  },
  "emmet.showSuggestionsAsSnippets": true,
  "editor.snippetSuggestions": "inline",
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "workbench.iconTheme": "file-icons-mac",
  "workbench.colorTheme": "Tokyo Night",
  "workbench.colorCustomizations": {
    "[SynthWave '84]": {
      "editor.wordHighlightBackground": "#83466b",
    },
    "editorWarning.foreground": "#00ff00",
  },
  "redhat.telemetry.enabled": false,
  "terminal.external.osxExec": "iTerm2.app",
  "terminal.integrated.lineHeight": 1.3,
  "git.autofetch": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.guides.bracketPairs": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.dragAndDrop": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.inlayHints.fontSize": 12,
  "editor.inlayHints.padding": true,
  "editor.cursorBlinking": "smooth",
  "vsicons.dontShowNewVersionMessage": true,
  "git.enableSmartCommit": false,
  "hediet.vscode-drawio.resizeImages": null,
  "update.showReleaseNotes": false,
  "nxConsole.showNodeVersionOnStartup": false,
  "eslint.codeActionsOnSave.rules": null,
  "exportall.config.exclude": [".test.", ".spec.", ".schema."],
  "editor.inlayHints.enabled": "offUnlessPressed",
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.*.ts",
    "blog.tsx": "${basename}.*.mdx",
    "*.tsx": "${capture}.*.tsx, ${capture}.*.ts",
  },
  "editor.acceptSuggestionOnCommitCharacter": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "mdx": false,
    "md": "false",
  },
  "[mdx]": {
    "editor.quickSuggestions": {
      "other": "off",
    },
    "github.copilot.editor.enableAutoCompletions": false,
  },
  "spellright.documentTypes": ["markdown", "latex", "plaintext"],
  "github.copilot.editor.enableAutoCompletions": true,
  "git.confirmSync": false,
  "spellright.language": ["en"],
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.preferences.importModuleSpecifier": "project-relative",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "[helm]": {},
  "editor.formatOnSave": true,
  "codeium.enableCodeLens": false,
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.tsserver.nodePath": "node",
  "files.watcherExclude": {
    "**/node_modules/**": true,
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[properties]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "security.promptForLocalFileProtocolHandling": false,
  "codeium.enableConfig": {
    "*": true,
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "docker.extension.enableComposeLanguageServer": false,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.allowBreakpointsEverywhere": true,
  "amp.url": "https://ampcode.com/",
  "amp.tab.enabled": true,
  "editor.wordBasedSuggestions": "off",
  "amp.tab.experimental.displayMode": "subtle",
  "amp.mcpServers": {
    "mui-mcp": {
      "command": "npx",
      "args": ["-y,", "@mui/mcp@latest"],
      "env": {},
    },
  },
  "git.replaceTagsWhenPull": true,
  "haskell.manageHLS": "GHCup",
  "amp.tab.disabledLanguages": ["haskell"],
  "[haskell]": {
    "editor.defaultFormatter": "haskell.haskell",
  },
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": false,
  "oxc.enable": true,
  "oxc.typeAware": true,
  "oxc.configPath": "",
  "prettier.enable": false,
  "editor.formatOnPaste": true,
  "chat.disableAIFeatures": true,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "git.detectWorktrees": true,
  "[typescript]": {},
  "js/ts.experimental.useTsgo": true,
}
